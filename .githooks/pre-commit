#!/bin/sh
# Refuse a commit when index.html and the js/ + css/ folders disagree:
# a file that is never loaded, a file that is loaded but missing, a
# syntax error, the same top-level name declared in two files, a call to
# a method one of the app's objects does not have, or a version stamp
# that no longer matches its file (fix those with
# `node tools/stamp-versions.js`, then `git add index.html`).
#
# It then runs ESLint for errors only. Errors are bugs that bite on a
# phone: an undefined name, a duplicate key, a condition that can never
# be true. Warnings are style notes and never block a commit — read them
# any time with `npm run lint`.
#
# Activation: `git config core.hooksPath .githooks` (done automatically
# by the `prepare` script in package.json on `npm install`).

if ! node -e "require('./tools/check-files.js')" 2>/dev/null; then
    echo "tools/check-files.js can't be loaded (missing file, syntax error,"
    echo "or missing dependency). Run \`npm install\` and try again."
    exit 1
fi

node tools/check-files.js || exit 1

if [ -f node_modules/.bin/eslint ]; then
    node_modules/.bin/eslint . --quiet || exit 1
else
    echo "ESLint is not installed, skipping it. Run \`npm install\` to switch it back on."
fi
